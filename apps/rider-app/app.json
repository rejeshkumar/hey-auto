{
  "expo": {
    "name": "Aye Auto",
    "slug": "hey-auto-rider",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "heyauto",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.heyauto.rider",
      "buildNumber": "5",
      "config": {
        "googleMapsApiKey": "AIzaSyBaOw8Yu2FKHSOSqnBbZNfPVBfJcD4J2i8"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aye Auto needs your location to find nearby drivers and show your position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aye Auto needs your location to track your ride.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "in.heyauto.rider",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBaOw8Yu2FKHSOSqnBbZNfPVBfJcD4J2i8"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aye Auto needs your location to find nearby drivers."
        }
      ],
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Aye Auto needs microphone access for voice booking."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffbe0b",
          "defaultChannel": "rides"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b1d96b06-bf4f-4eb8-bf77-d3f07873f1cc"
      }
    },
    "owner": "rejeshkumarkp"
  }
}
