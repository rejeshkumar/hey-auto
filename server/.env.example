NODE_ENV=development
# Comma-separated phones that always get OTP 123456 even when WhatsApp/SMS is live (testing)
# DEMO_OTP_PHONES=+919999999999,+918095481555
PORT=3000
API_VERSION=v1

DATABASE_URL=postgresql://heyauto:heyauto123@localhost:5432/heyauto
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your-access-secret-min-16-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

OTP_EXPIRY_SEC=300
DRIVER_SEARCH_RADIUS_KM=3
RIDE_REQUEST_TIMEOUT_SEC=15
MAX_MATCHING_ROUNDS=3

# ── Cloudflare R2 (File Storage — REQUIRED for production) ────────────────────
# Free tier: 10GB storage + 1M ops/month. Zero egress cost.
# Setup: https://dash.cloudflare.com → R2 → Create Bucket (name: heyauto-uploads)
#        → Manage R2 API Tokens → Create Token (Object Read & Write)
#        → Copy Account ID from R2 overview page
#
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=heyauto-uploads
# Optional: custom domain for public file URLs (e.g. files.heyauto.in)
# Set this after enabling public access on the bucket in Cloudflare dashboard.
# Without it, R2 dev URLs are used (fine for MVP).
R2_PUBLIC_URL=

# ── Google Maps ───────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Enable: Directions API, Places API, Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=

# ── SMS Gateway ───────────────────────────────────────────────────────────────
# Fast2SMS (India): https://fast2sms.com → API → Dev API Key
FAST2SMS_API_KEY=

# Twilio fallback (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payments ─────────────────────────────────────────────────────────────────
# Razorpay: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cashfree (Driver Subscription Payments) ───────────────────────────────────
# Sign up: https://merchant.cashfree.com → Developers → API Keys
# Set CASHFREE_ENV=production when going live (default: sandbox for testing)
# Webhook URL to add in Cashfree dashboard:
#   https://hey-auto-server-production.up.railway.app/api/v1/subscription/cashfree-webhook
# Webhook events to enable: PAYMENT_LINK_EVENT
#
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Firebase (Push Notifications) ────────────────────────────────────────────
# Full setup: see server/FIREBASE_SETUP_GUIDE.md
#
# Step 1: console.firebase.google.com → New project (name: hey-auto)
# Step 2: Project Settings → Cloud Messaging → copy Server Key
# Step 3: expo.dev → Project → Push Notifications → add FCM Server Key
# Step 4: That's it — the server sends via Expo, not Firebase directly
#
# Server key is stored here for reference only (not used at runtime):
FCM_SERVER_KEY=
# Legacy fields (not used — Expo handles FCM internally):
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ── Error Monitoring ──────────────────────────────────────────────────────────
# Sentry: https://sentry.io → New Project → Node.js → copy DSN
SENTRY_DSN=

# ── AWS S3 (legacy — use R2 above instead) ───────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=heyauto-uploads
